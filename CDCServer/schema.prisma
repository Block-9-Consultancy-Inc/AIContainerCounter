datasource db {
  provider = "postgres"
  url      = env("DB_URL")
}

generator client {
    provider             = "prisma-client-py"
    recursive_type_depth = 5
}

enum DatasetSplit {
    TRAIN
    VALID
    TEST
}

enum CountingStrategy {
    DUAL_MODEL_SNAPSHOT
    YOLO_CONSENSUS
    SIMPLE_COUNT
}

enum CountiUnitStatus {
    RUNNING
    INITIALIZING
    UPLOADING
    IDLE
    ERROR
}

model CountiUnit {
    id                          String              @id
    location                    String
    registered                  DateTime            @default(now())
    updated                     DateTime            @updatedAt
    status                      CountiUnitStatus
    batches                     Batch[]
}

enum ModelType {
    YOLO_CONTAINER
    YOLO_CATEGORY
    RESNET_CATEGORY
}

model TrainedModel {
    id                          String              @id @default(uuid()) @db.Uuid
    modelType                   ModelType
    description                 String?
    trained                     DateTime            @default(now())
    checkpointId                String?             @db.Uuid
    checkpoint                  TrainedModel?       @relation("ModelCheckpoint", fields: [checkpointId], references: [id])
    successors                  TrainedModel[]      @relation("ModelCheckpoint")
    datasetSnapshotId           String?             @db.Uuid
    datasetSnapshot             DatasetSnapshot?    @relation(fields: [datasetSnapshotId], references: [id])
    batchesWithCategoryModel    Batch[]             @relation("CategoryModel")
    batchesWithContainerModel   Batch[]             @relation("ContainerModel")
}

enum DatasetSnapshotType {
    CHECKPOINT
    FROM_SCRATCH
}

model DatasetSnapshot {
    id                          String              @id @default(uuid()) @db.Uuid
    description                 String?
    created                     DateTime            @default(now())
    snapshotType                DatasetSnapshotType
    randomSubSampleSeed         String?
    randomSubSampleTrainAmount  Int?
    randomSubSampleValidAmount  Int?
    randomSubSampleTestAmount   Int?
    trainedModels               TrainedModel[]
    imageInDatasetSnapshot      ImageInDatasetSnapshot[]
}

model ImageInDatasetSnapshot {
    datasetSnapshot             DatasetSnapshot     @relation(fields: [datasetSnapshotId], references: [id])
    datasetSnapshotId           String              @db.Uuid
    image                       Image               @relation(fields: [imageId], references: [id])
    imageId                     String              @db.Uuid
    split                       DatasetSplit
    @@id([datasetSnapshotId, imageId])
}

model VerificationSession {
    id                          String              @id @default(uuid()) @db.Uuid
    userId                      String
    timeAssigned                DateTime            @default(now())
    timeCompleted               DateTime?
    imageInVerificationSession  ImageInVerificationSession[]
}

enum CorrectionType {
    ADDED_MISSING
    REMOVED_EXTRA
    CHANGED_LABEL
    CHANGED_COORDS
}

model Correction {
    id                          String              @id @default(uuid()) @db.Uuid
    correctionType              CorrectionType
    newLabel                    String?
    x1                          Int?
    y1                          Int?
    x2                          Int?
    y2                          Int?
    originalBBox                BBox?                @relation(fields: [originalBBoxId], references: [id])
    originalBBoxId              String?              @db.Uuid
    imageInVerificationSession  ImageInVerificationSession @relation(fields: [verificationSessionId, imageId], references: [verificationSessionId, imageId])
    verificationSessionId       String               @db.Uuid
    imageId                     String               @db.Uuid
}

model ImageInVerificationSession {
    verificationSession         VerificationSession @relation(fields: [verificationSessionId], references: [id])
    verificationSessionId       String              @db.Uuid
    image                       Image               @relation(fields: [imageId], references: [id])
    imageId                     String              @db.Uuid
    corrections                 Correction[]
    @@id([verificationSessionId, imageId])
}

enum ImageStatus {
    ON_QUEUE
    VERIFICATION_IN_PROGRESS
    VERIFIED
}

model Image {
    id                          String              @id @default(uuid()) @db.Uuid
    fileExtension               String
    index                       Int
    height                      Int
    width                       Int
    timeTaken                   DateTime
    batch                       Batch               @relation(fields: [batchId], references: [id])
    batchId                     String              @db.Uuid
    chunkId                     String              @db.Uuid
    bboxes                      BBox[]
    imageInDatasetSnapshot      ImageInDatasetSnapshot[]
    tags                        ImageWithTag[]
    imageStatus                 ImageStatus         @default(ON_QUEUE)
    imageInVerificationTask     ImageInVerificationSession[]
}

model ImageWithTag {
    image                       Image               @relation(fields: [imageId], references: [id])
    imageId                     String              @db.Uuid
    tag                         ImageTag            @relation(fields: [tagName], references: [name])
    tagName                     String              
    @@id([imageId, tagName])
}

model ImageTag {
    name                        String              @id
    description                 String?
    images                      ImageWithTag[]
}

model Video {
    batchId                     String              @id @db.Uuid @unique
    fileExtension               String
    height                      Int
    width                       Int
    batch                       Batch               @relation(fields: [batchId], references: [id])
}

model Batch {
    id                          String              @id @default(uuid()) @db.Uuid
    count                       Int
    canCount                    Int
    plasticCount                Int
    gabletopCount               Int
    drinkboxCount               Int
    pouchCount                  Int
    timeStarted                 DateTime
    timeSubmitted               DateTime
    miscellaneousNotes          String?
    areaCollected               String?
    countiUnit                  CountiUnit          @relation(fields: [countiUnitId], references: [id])
    countiUnitId                String
    countingStrategy            CountingStrategy
    containerModel              TrainedModel?       @relation(name: "ContainerModel", fields: [containerModelId], references: [id])
    containerModelId            String?             @db.Uuid
    categoryModel               TrainedModel?       @relation(name: "CategoryModel", fields: [categoryModelId], references: [id])
    categoryModelId             String?             @db.Uuid
    images                      Image[]
    video                       Video?
    tags                        BatchWithTag[]
}

model BatchWithTag {
    batch                       Batch               @relation(fields: [batchId], references: [id])
    batchId                     String              @db.Uuid
    tag                         BatchTag            @relation(fields: [tagName], references: [name])
    tagName                     String              
    @@id([batchId, tagName])
}

model BatchTag {
    name                        String              @id
    description                 String?
    batches                     BatchWithTag[]
}

model BBox {
    id                          String              @id @default(uuid()) @db.Uuid
    image                       Image               @relation(fields: [imageId], references: [id])
    imageId                     String              @db.Uuid
    label                       String
    x1                          Int
    y1                          Int
    x2                          Int 
    y2                          Int
    corrections                 Correction[]
}
